events {}

http {
  include /etc/nginx/mime.types;
  # optional default
  default_type application/octet-stream;

  server {
    listen 80;
    listen 8080; # Internal only
#    server_name external.hostname;
    server_name localhost;
  
    # Redirect requests to HTTPS
#    location / {
#    	return 301 https://$host$request_uri;
#    }
    
    root /var/www/html;
    index index.php;

    client_max_body_size 50M;

    location ^~ /resources/  { try_files $uri =404; }
    location ^~ /skins/      { try_files $uri =404; }
    location ^~ /extensions/ { try_files $uri =404; }
    location ^~ /images/     { try_files $uri =404; }

    # Certificate autorenewal
    # add to cron:
    # docker compose run --rm certbot renew --deploy-hook "docker compose exec -T nginx nginx -s reload" --disable-hook-validation
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Front controller for pretty URLs
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
    
    location /cache/ {
    	alias /app/cache/;
    	types {
    		application/pdf  pdf;
    	}
    }
    
    #    # Disable logging
    #    access_log /dev/null;
    #    error_log /dev/null crit;
    
    # PHP → FPM
    location ~ \.php$ {
      # Only execute real files
      try_files $fastcgi_script_name =404;

      # Support /index.php/some/path
      fastcgi_split_path_info ^(.+\.php)(/.+)$;

      include fastcgi_params;

      # CRITICAL: map to the real file path that exists *inside the FPM container*
      fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
      fastcgi_param SCRIPT_NAME     $fastcgi_script_name;
      fastcgi_param PATH_INFO       $fastcgi_path_info;
      fastcgi_param HTTP_PROXY      ""; # mitigate httpoxy

      # Service name:port on your Docker network
      fastcgi_pass mediawiki:9000;

      # Optional tuning
      # fastcgi_buffers 16 16k;
      # fastcgi_buffer_size 32k;
    }

  }

#  server {
#    listen 443 ssl;
#    server_name external.hostname;
#
